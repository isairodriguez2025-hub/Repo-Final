# ---------------------------------------------------------------------------
# Didi2 B2B - variables de entorno
# Copia este archivo como .env y llena los valores. NUNCA subas .env a Git.
# ---------------------------------------------------------------------------

APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# --- Base de datos ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=didi2
DB_USER=didi2_app
DB_PASS=
DB_MIGRATOR_USER=didi2_migrator
DB_MIGRATOR_PASS=

# --- Correo ----------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@didi2.mx

# --- Seguridad -------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrar datos sensibles (RFC, KYC).
# Generar con: php -r "echo base64_encode(random_bytes(32));"
SODIUM_KEY=

# Token para el endpoint /internal/tick que dispara el worker.
CRON_TOKEN=

# --- Servicios externos ----------------------------------------------------
NOMINATIM_UA="Didi2-Academico/1.0 (contacto@didi2.mx)"
OSRM_URL=https://router.project-osrm.org
